# Backend environment for local development (copy to klask-rs/.env).
# The backend loads this file at startup (dotenvy). Every variable is documented
# in docs/admin/configuration.md.
#
# Database: `docker compose -f docker-compose.dev.yml up -d postgres` (repository root)
# publishes PostgreSQL on 127.0.0.1:5433 with the credentials below.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgres://klask_user:klask_password@127.0.0.1:5433/klask_dev

# At least 32 characters, e.g. `openssl rand -hex 32`. Use your own value.
JWT_SECRET=change-me-development-only-0123456789abcdef

# At least 16 characters (exactly 32 avoids a startup warning), e.g.
# `openssl rand -hex 16`. Encrypts repository access tokens stored in the database.
ENCRYPTION_KEY=change-me-dev-key-0123456789abcd

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=3000
RUST_LOG=info
# DATABASE_MAX_CONNECTIONS=10

# --- Authentication and CORS -----------------------------------------------
# Token lifetime: a number followed by s, m, h or d (a bare number means hours).
JWT_EXPIRES_IN=24h
# Self-service registration from the login page. Default: false (create the
# first admin on /setup, then add users from the admin panel).
ALLOW_REGISTRATION=false
# Comma-separated origins allowed by CORS (the frontend dev server by default).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Add the Secure attribute to the session cookie (set true behind HTTPS).
# COOKIE_SECURE=false
# Reverse proxies appending to X-Forwarded-For in front of the backend
# (0 = ignore the header). Count only the proxies the request really goes through.
# TRUSTED_PROXY_HOPS=0
# Secret required by the first-run setup (POST /api/auth/setup) while no user exists.
# SETUP_TOKEN=

# --- Repositories -----------------------------------------------------------
# Allow http:// and private/loopback hosts for Git, GitLab and GitHub repositories.
# Set false on an instance exposed to untrusted administrators.
# ALLOW_PRIVATE_NETWORK_URLS=true
# Comma-separated directories FileSystem repositories may point into
# (empty = no FileSystem repository can be created).
# FILESYSTEM_ALLOWED_ROOTS=

# --- Limits -----------------------------------------------------------------
# MAX_REQUEST_BODY_BYTES=4194304
# REQUEST_TIMEOUT_SECS=60

# --- Search index and crawler ----------------------------------------------
SEARCH_INDEX_DIR=./index
# Directory where repositories are cloned while being crawled
# (default: <system temp dir>/klask-crawler).
CRAWLER_TEMP_DIR=./temp_crawl
# KLASK_TANTIVY_MEMORY_MB=200
# KLASK_TANTIVY_NUM_THREADS=
# KLASK_SKIP_RESUME_CRAWLS=false
# Sensitive files (.env and .env.*, .npmrc, private keys, *.pem, *.key, ...) are
# excluded from the index by default; env templates (.env.example, ...) are kept.
# Set to true to index the built-in list too (not recommended).
# KLASK_INDEX_SENSITIVE_FILES=false
# Extra comma-separated glob patterns to exclude (a file name, or a trailing
# path such as .kube/config).
# KLASK_EXCLUDED_FILE_PATTERNS=
# Maximum duration of a git fetch / clone, in seconds.
# KLASK_GIT_FETCH_TIMEOUT_SECS=1800
# KLASK_GIT_CLONE_TIMEOUT_SECS=3600

# --- Semantic search (optional) ---------------------------------------------
# Needs a binary built with `cargo build --features semantic-search`; the
# published Docker images are not necessarily built with it. The embedding model
# runs locally (ONNX) and is downloaded into the cache dir on first start.
SEMANTIC_SEARCH_ENABLED=false
SEMANTIC_SEARCH_MODEL=jinaai/jina-embeddings-v2-base-code
SEMANTIC_SEARCH_CACHE_DIR=./models
SEMANTIC_SEARCH_VECTOR_DIR=./vector-index
SEMANTIC_SEARCH_CHUNK_MAX_LINES=45
SEMANTIC_SEARCH_CHUNK_OVERLAP_LINES=10
SEMANTIC_SEARCH_BATCH_SIZE=32
SEMANTIC_SEARCH_QUEUE_CAPACITY=1000

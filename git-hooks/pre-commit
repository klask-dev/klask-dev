#!/bin/bash
# Pre-commit hook for Klask
# Fast formatting and linting checks before commits
# Heavy tests are deferred to pre-push for faster workflow

set -e

echo "⚡ Running fast pre-commit checks for Klask..."

# Detect which part of the project changed
CHANGED_RUST=false
CHANGED_REACT=false

if git diff --cached --name-only | grep -q "^klask-rs/"; then
    CHANGED_RUST=true
fi

if git diff --cached --name-only | grep -q "^klask-react/"; then
    CHANGED_REACT=true
fi

# Rust backend checks - fast only
if [ "$CHANGED_RUST" = true ]; then
    echo ""
    echo "🦀 Checking Rust backend (fast checks only)..."

    cd klask-rs

    # Format code
    echo "  ├─ Formatting code..."
    cargo fmt --check || {
        echo "  │  ⚠️  Code not formatted. Running cargo fmt..."
        cargo fmt
        echo "  │  ✅ Code formatted"
    }

    echo "  └─ ✅ Rust formatting passed"
    echo "  💡 Clippy and tests will run on git push (pre-push hook)"
    cd ..
fi

# React frontend checks - fast only
if [ "$CHANGED_REACT" = true ]; then
    echo ""
    echo "⚛️  Checking React frontend (fast checks only)..."

    cd klask-react

    # Lint and fix only changed TypeScript/TSX files
    echo "  ├─ Running ESLint on changed files..."
    CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E "^klask-react/.*\.(ts|tsx)$" | sed 's|^klask-react/||')
    if [ -n "$CHANGED_FILES" ]; then
        # Auto-fix what can be fixed
        npx eslint --fix --max-warnings 500 $CHANGED_FILES 2>/dev/null
        # Verify final state
        npx eslint --max-warnings 500 $CHANGED_FILES || {
            echo "  │  ❌ ESLint found issues that couldn't be auto-fixed."
            cd ..
            exit 1
        }
    fi

    echo "  └─ ✅ ESLint checks passed"
    echo "  💡 Type checking and tests will run on git push (pre-push hook)"
    cd ..
fi

echo ""
echo "✅ Fast pre-commit checks passed! You can commit."
echo "📋 Note: Type checking and tests will run when you push."

# Environment for docker-compose.yml (copy to .env and fill in the three secrets).
#   cp .env.example .env
# Every variable the backend reads is documented in docs/admin/configuration.md.

# --- Required: compose refuses to start while these are empty ---------------

# Password of the bundled PostgreSQL. Use hex or alphanumerics only: it is
# inserted into the database URL as-is.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login tokens. At least 32 characters or the backend refuses to start.
#   openssl rand -hex 32
JWT_SECRET=

# Encrypts the repository access tokens stored in the database. At least 16
# characters; exactly 32 avoids a warning at startup. If you lose or change it,
# the stored tokens can no longer be decrypted.
#   openssl rand -hex 16
ENCRYPTION_KEY=

# --- Optional ---------------------------------------------------------------

# Image tag for ghcr.io/klask-dev/klask-backend and klask-frontend
# (default: latest). Pin a release such as 2.2.0 for reproducible deployments.
# KLASK_IMAGE_TAG=latest

# URL the browser uses to reach the backend API (default: http://localhost:3000,
# which only works on the machine running the stack). To serve Klask to other
# machines, set it to an empty value: the browser then calls /api on the host
# that serves the interface (port 8080), and that container relays it to the
# backend. Set TRUSTED_PROXY_HOPS accordingly (docs/admin/installation.md).
# BACKEND_BASE_URL=
# TRUSTED_PROXY_HOPS=1

# Origins allowed by CORS, comma-separated: must include the URL of the
# frontend as seen in the browser (default in compose: http://localhost:8080).
# ALLOWED_ORIGINS=http://localhost:8080
